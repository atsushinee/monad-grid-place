# ===================================
# Indexer Configuration
# ===================================

# Monad 测试网 WebSocket RPC
RPC_WSS_URL=wss://testnet.monad.xyz

# 合约地址（部署后更新）
CONTRACT_ADDRESS=0xYourContractAddressHere

# 数据库连接
DATABASE_URL=postgres://user:password@localhost:5432/gridplace

# 后端 API URL（用于 CID 缓存查询）
BACKEND_API_URL=http://127.0.0.1:3000

# ===================================
# IPFS Configuration
# ===================================
# 选择使用 Pinata 或本地 IPFS（二选一）
# 必须与后端的 IPFS 配置保持一致！

# --- 选项 A: 使用 Pinata (推荐生产环境) ---
# 设置为 true 启用 Pinata
USE_PINATA=false

# Pinata API 凭证（当 USE_PINATA=true 时必需）
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here
# Pinata JWT（可选，某些认证方式需要）
PINATA_JWT=

# Pinata Gateway URL（通常不需要修改）
PINATA_GATEWAY_URL=https://gateway.pinata.cloud

# --- 选项 B: 使用本地 IPFS（开发环境） ---
# 当 USE_PINATA=false 时使用以下配置
IPFS_GATEWAY_URL=http://127.0.0.1:8080

# ===================================
# 使用说明
# ===================================
# 1. 本地开发（使用 Docker IPFS）:
#    - 设置 USE_PINATA=false
#    - 运行：docker-compose -f ./ipfs/docker-compose.yml up -d
#    - 使用默认 IPFS_GATEWAY_URL
#
# 2. 生产环境（使用 Pinata）:
#    - 设置 USE_PINATA=true
#    - 填写 PINATA_API_KEY 和 PINATA_SECRET_KEY
#    - 可选：配置 PINATA_GATEWAY_URL 使用自定义网关
#
# 3. 获取 Pinata API Key:
#    - 访问 https://pinata.cloud
#    - 注册账号
#    - 在 Settings > API Keys 中创建 API Key
#
# 4. 重要：Indexer 的 IPFS 配置必须与后端保持一致！
#    - 如果后端使用 Pinata，Indexer 也必须使用 Pinata
#    - 如果后端使用本地 IPFS，Indexer 也必须使用本地 IPFS
