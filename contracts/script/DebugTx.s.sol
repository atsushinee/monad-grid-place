pragma solidity ^0.8.20;

import "forge-std/Script.sol";

contract DebugTx is Script {
    function run() external {
        // Anvil 默认第一个账户的私钥
        uint256 deployerPrivateKey = 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80;
        vm.startBroadcast(deployerPrivateKey);

        address proxyAddr = 0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512;

        // 【全量数据：不省略】
        // 这是你前端发出的完整 payload，包含了函数选择器 0xec934706
        bytes memory fullPayload = hex"";

        // 尝试发送交易。前端发的是 8.75 ether。
        (bool success, bytes memory returnData) = proxyAddr.call{value: 8.75 ether}(fullPayload);

        if (!success) {
            // 如果失败，打印 Revert 原因
            if (returnData.length > 0) {
                console.log("Failed with revert reason:");
                console.logBytes(returnData);
            } else {
                console.log("Failed with no revert reason");
            }
        } else {
            console.log("Transaction success!");
        }

        vm.stopBroadcast();
    }
}