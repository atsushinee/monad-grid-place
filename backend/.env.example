# Port for the backend server
PORT=3000

# Database connection string
DATABASE_URL=postgres://user:password@localhost/gridplace

# ===================================
# IPFS Configuration
# ===================================
# 选择使用 Pinata 或本地 IPFS（二选一）

# --- 选项 A: 使用 Pinata (推荐生产环境) ---
# 设置为 true 启用 Pinata
USE_PINATA=false

# Pinata API 凭证（当 USE_PINATA=true 时必需）
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here
# Pinata JWT（可选，某些认证方式需要）
PINATA_JWT=

# Pinata API 和 Gateway URL（通常不需要修改）
PINATA_API_URL=https://api.pinata.cloud
PINATA_GATEWAY_URL=https://gateway.pinata.cloud

# --- 选项 B: 使用本地 IPFS（开发环境） ---
# 当 USE_PINATA=false 时使用以下配置
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080

# ===================================
# 使用说明
# ===================================
# 1. 本地开发（使用 Docker IPFS）:
#    - 设置 USE_PINATA=false
#    - 运行：docker-compose -f ./ipfs/docker-compose.yml up -d
#    - 使用默认 IPFS_API_URL 和 IPFS_GATEWAY_URL
#
# 2. 生产环境（使用 Pinata）:
#    - 设置 USE_PINATA=true
#    - 填写 PINATA_API_KEY 和 PINATA_SECRET_KEY
#    - 可选：配置 PINATA_GATEWAY_URL 使用自定义网关
#
# 3. 获取 Pinata API Key:
#    - 访问 https://pinata.cloud
#    - 注册账号
#    - 在 Settings > API Keys 中创建 API Key
